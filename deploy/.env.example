# Configuration de la production. Copier en deploy/.env (ignoré par git) et adapter :
#   cp deploy/.env.example deploy/.env

# --- Serveur
# Destination de deploy.sh : utilisateur@serveur (ssh) ou « local » (cette machine)
DEPLOY_HOST=pi@raspberrypi.local
# Dossier d'installation sur le serveur (relatif au dossier personnel, ou absolu)
DEPLOY_DIR=family
# Port HTTP publié par nginx
HTTP_PORT=80

# --- Base de données (obligatoire) : générer par ex. avec  openssl rand -base64 24
DB_PASSWORD=

# --- Votre famille (hors dépôt) : fichier copié sur le serveur, lu au premier démarrage seulement
FAMILLE_JSON=backend/famille.json

# --- Mot de passe d'accès au site (fortement conseillé : l'application n'a pas de comptes)
# Les deux vides = aucun mot de passe. Le mot de passe n'est pas copié sur le serveur (seulement son empreinte).
APP_USER=famille
APP_PASSWORD=

# --- Lieu et heure
APP_TIMEZONE=Europe/Brussels
METEO_LIEU=Bruxelles
METEO_LATITUDE=50.85
METEO_LONGITUDE=4.35
METEO_HEURE_DEPART=8
