# Configuration de la production. Copier en deploy/.env (ignoré par git, ne jamais le committer) et adapter :
#   cp deploy/.env.example deploy/.env

# --- Serveur
# Destination de deploy.sh : alias ssh (ou utilisateur@serveur), ou « local » (cette machine)
DEPLOY_HOST=vps-claude
# Dossier d'installation sur le serveur (relatif au dossier personnel, ou absolu)
DEPLOY_DIR=family
# Port du nginx du conteneur, publié sur 127.0.0.1 seulement (le nginx de l'hôte y relaie HTTPS)
HTTP_PORT=8090
# Adresse publique (affichée à la fin du déploiement)
PUBLIC_URL=https://famille.gilmotech.be

# --- Base de données (obligatoire) : openssl rand -base64 24
DB_PASSWORD=

# --- Premier compte parent : obligatoire au PREMIER déploiement seulement (base sans compte).
# 10 caractères minimum. Le mot de passe est retiré du .env du serveur après le premier déploiement réussi.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Sécurité des sessions
# Cookies réservés à HTTPS
AGENDA_COOKIE_SECURE=true
# Clé fixe des jetons « rester connecté » (obligatoire) : openssl rand -base64 32
AGENDA_REMEMBER_ME_KEY=

# --- Votre famille (hors dépôt) : copiée sur le serveur au premier déploiement, puis supprimée du serveur
FAMILLE_JSON=backend/famille.json

# --- Sauvegardes de la base sur le serveur (cron de l'utilisateur, installé par deploy.sh ; vide = aucune)
# Format cron, heure du serveur. Les 30 dernières sont gardées (backups/), sans copie hors du serveur.
BACKUP_CRON="0 3 * * *"

# --- Lieu et heure
APP_TIMEZONE=Europe/Brussels
METEO_LIEU=Bruxelles
METEO_LATITUDE=50.85
METEO_LONGITUDE=4.35
METEO_HEURE_DEPART=8
