# nginx du conteneur : front (fr / nl) et relais de /v1 vers le backend. HTTPS, en-têtes de sécurité et
# limitation de débit sont assurés par le nginx de l'hôte (deploy/host/nginx-famille.conf), seul à le joindre.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    # Redirections relatives (« Location: /fr/ ») : ce nginx ne voit que du http, une redirection absolue
    # renverrait vers http:// au lieu de l'https du nginx de l'hôte
    absolute_redirect off;

    # IP du client : celle que le nginx de l'hôte a écrite dans X-Forwarded-For (il l'écrase avec $remote_addr,
    # un en-tête envoyé par le client est donc ignoré). Il nous joint par la passerelle du réseau Docker.
    set_real_ip_from 127.0.0.1;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = / {
        return 302 /fr/;
    }

    # Fichiers à empreinte (chunk-XXXX.js, styles-XXXX.css) : cache long
    location ~* ^/(fr|nl)/.+\.(js|css|woff2)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Une langue = un build : les routes inconnues renvoient l'index.html de la langue
    location /fr/ {
        try_files $uri $uri/ /fr/index.html;
        add_header Cache-Control "no-cache";
    }

    location /nl/ {
        try_files $uri $uri/ /nl/index.html;
        add_header Cache-Control "no-cache";
    }

    location /v1/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        # Une seule IP, celle du client vue par l'hôte (jamais enrichie : le backend prend la première)
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /actuator/health {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}
