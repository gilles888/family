# Modèle nginx : l'image remplace ${AUTH_BASIC} au démarrage (les variables nginx comme $uri restent telles quelles).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    auth_basic "${AUTH_BASIC}";
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = / {
        return 302 /fr/;
    }

    # Fichiers à empreinte (chunk-XXXX.js, styles-XXXX.css) : cache long
    location ~* ^/(fr|nl)/.+\.(js|css|woff2)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Une langue = un build : les routes inconnues renvoient l'index.html de la langue
    location /fr/ {
        try_files $uri $uri/ /fr/index.html;
        add_header Cache-Control "no-cache";
    }

    location /nl/ {
        try_files $uri $uri/ /nl/index.html;
        add_header Cache-Control "no-cache";
    }

    location /v1/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
