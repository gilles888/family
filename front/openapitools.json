{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.25.0",
    "generators": {
      "api": {
        "generatorName": "typescript-angular",
        "inputSpec": "http://localhost:8080/v3/api-docs",
        "output": "src/app/api-client",
        "additionalProperties": {
          "ngVersion": "22.0.0",
          "providedIn": "root",
          "fileNaming": "kebab-case",
          "supportsES6": true
        },
        "typeMappings": {
          "set": "Array"
        }
      },
      "api-file": {
        "generatorName": "typescript-angular",
        "inputSpec": "openapi/family-agenda.json",
        "output": "src/app/api-client",
        "additionalProperties": {
          "ngVersion": "22.0.0",
          "providedIn": "root",
          "fileNaming": "kebab-case",
          "supportsES6": true
        },
        "typeMappings": {
          "set": "Array"
        }
      }
    }
  }
}
